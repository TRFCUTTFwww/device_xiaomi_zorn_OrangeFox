diff --git a/Weaver.cpp b/Weaver.cpp
new file mode 100644
index 0000000..42d53c9
--- /dev/null
+++ b/Weaver.cpp
@@ -0,0 +1,53 @@
+#include "Weaver.h"
+#include <android-base/logging.h>
+#include <android/binder_manager.h>
+#include <aidl/android/hardware/weaver/IWeaver.h>
+
+using aidl::android::hardware::weaver::IWeaver;
+
+namespace android {
+namespace vold {
+
+bool Weaver::isSupported() {
+    std::string instance = std::string(IWeaver::descriptor) + "/default";
+    return AServiceManager_isDeclared(instance.c_str());
+}
+
+bool Weaver::read(uint32_t slot, const std::vector<uint8_t>& key, std::vector<uint8_t>* value) {
+    std::string instance = std::string(IWeaver::descriptor) + "/default";
+    auto binder = ndk::SpAIBinder(AServiceManager_waitForService(instance.c_str()));
+    auto service = IWeaver::fromBinder(binder);
+
+    if (!service) {
+        LOG(ERROR) << "zorn: Failed to find Weaver AIDL service";
+        return false;
+    }
+
+    aidl::android::hardware::weaver::WeaverReadResponse response;
+    auto status = service->read(slot, key, &response);
+
+    if (!status.isOk()) {
+        LOG(ERROR) << "zorn: Weaver read failed";
+        return false;
+    }
+
+    if (response.status == aidl::android::hardware::weaver::WeaverReadStatus::OK) {
+        *value = response.value;
+        return true;
+    }
+    
+    return false;
+}
+
+bool Weaver::write(uint32_t slot, const std::vector<uint8_t>& key, const std::vector<uint8_t>& value) {
+    std::string instance = std::string(IWeaver::descriptor) + "/default";
+    auto binder = ndk::SpAIBinder(AServiceManager_waitForService(instance.c_str()));
+    auto service = IWeaver::fromBinder(binder);
+
+    if (!service) return false;
+    auto status = service->write(slot, key, value);
+    return status.isOk();
+}
+
+}  // namespace vold
+}  // namespace android
