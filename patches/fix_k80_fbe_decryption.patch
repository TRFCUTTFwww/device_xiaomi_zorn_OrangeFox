+#pragma once
+#include <utils/StrongPointer.h>
+#include <vector>
+
+namespace android {
+namespace vold {
+
+class Weaver {
+public:
+    static bool isSupported();
+    static bool read(uint32_t slot, const std::vector<uint8_t>& key, std::vector<uint8_t>* value);
+    static bool write(uint32_t slot, const std::vector<uint8_t>& key, const std::vector<uint8_t>& value);
+};
+
+}  // namespace vold
+}  // namespace android
