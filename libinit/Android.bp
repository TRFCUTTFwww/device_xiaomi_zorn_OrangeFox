*/
cc_library_static {
    name: "libinit_zorn",
    defaults: [
        "libinit_zorn_defaults",
    ],
    header_libs: [
        "libbase_headers",
        "libcutils_headers",
    ],
    cflags: [
        "-Wall",
    ],
    static_libs: [
        "libbase",
    ],
    srcs: ["init_zorn.cpp"],
    recovery_available: true,
}
